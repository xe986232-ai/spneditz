# Salin file ini jadi ".env" lalu isi sesuai kebutuhan.

# Kode akses buat buka /stats dan /api/stats — GANTI, jangan pakai default.
ADMIN_KEY=ganti-kode-ini

# Domain frontend yang boleh manggil /api/export-log dari browser.
# Contoh: https://spneditz.vercel.app
# Boleh lebih dari satu, pisahkan koma. "*" = semua domain (buat testing aja).
ALLOWED_ORIGIN=*

# Port server (opsional, kalau hosting kamu udah nentuin sendiri lewat env PORT)
PORT=3001
